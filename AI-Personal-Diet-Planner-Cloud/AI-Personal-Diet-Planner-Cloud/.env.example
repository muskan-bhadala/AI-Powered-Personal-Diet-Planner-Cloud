# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub (it's already in .gitignore).

# --- Backend server ---
PORT=5000
FLASK_DEBUG=true

# --- Auth ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-long-random-secret

# --- "Cloud" database (simulated locally with SQLite) ---
# For a real cloud deployment, replace database_service.py's connection
# logic and point this at your managed database instead.
DATABASE_PATH=./cloud_db.sqlite3

# --- "Cloud" object storage (simulated locally with a folder) ---
# For a real cloud deployment, point this at an S3/Firebase/GCS bucket
# inside storage_service.py instead of a local folder.
STORAGE_BUCKET_PATH=./storage_bucket

# --- Optional external AI API (Version B of the AI engine) ---
# Leave USE_AI_API=false to always use the free, local rule-based engine.
USE_AI_API=false
AI_API_KEY=
